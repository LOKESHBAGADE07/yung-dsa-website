{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://va.vercel-scripts.com https://assets.emergent.sh https://ap.emergent.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-src 'self' https://www.youtube-nocookie.com https://open.spotify.com; worker-src 'self' blob:;"
        }
      ]
    }
  ],
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "installCommand": "yarn install",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/style/index.html",
      "destination": "/style/",
      "permanent": true
    },
    {
      "source": "/style/goggles-sunglasses/index.html",
      "destination": "/style/goggles-sunglasses/",
      "permanent": true
    },
    {
      "source": "/style/baggy-lowers/index.html",
      "destination": "/style/baggy-lowers/",
      "permanent": true
    },
    {
      "source": "/style/looks/index.html",
      "destination": "/style/looks/",
      "permanent": true
    },
    {
      "source": "/style/about/index.html",
      "destination": "/style/about/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/style/",
      "destination": "/style/index.html"
    },
    {
      "source": "/style/goggles-sunglasses/",
      "destination": "/style/goggles-sunglasses/index.html"
    },
    {
      "source": "/style/baggy-lowers/",
      "destination": "/style/baggy-lowers/index.html"
    },
    {
      "source": "/style/looks/",
      "destination": "/style/looks/index.html"
    },
    {
      "source": "/style/about/",
      "destination": "/style/about/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
