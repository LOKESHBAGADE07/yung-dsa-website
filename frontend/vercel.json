{
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "installCommand": "yarn install",
  "framework": null,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/.*$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://va.vercel-scripts.com https://assets.emergent.sh https://ap.emergent.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-src 'self' https://www.youtube-nocookie.com https://open.spotify.com; worker-src 'self' blob:;"
      },
      "continue": true
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/style/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/"
      }
    },
    {
      "src": "^/style/goggles-sunglasses/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/goggles-sunglasses/"
      }
    },
    {
      "src": "^/style/baggy-lowers/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/baggy-lowers/"
      }
    },
    {
      "src": "^/style/looks/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/looks/"
      }
    },
    {
      "src": "^/style/about/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/about/"
      }
    },
    {
      "src": "^/style$",
      "status": 308,
      "headers": {
        "Location": "/style/"
      }
    },
    {
      "src": "^/style/goggles-sunglasses$",
      "status": 308,
      "headers": {
        "Location": "/style/goggles-sunglasses/"
      }
    },
    {
      "src": "^/style/baggy-lowers$",
      "status": 308,
      "headers": {
        "Location": "/style/baggy-lowers/"
      }
    },
    {
      "src": "^/style/looks$",
      "status": 308,
      "headers": {
        "Location": "/style/looks/"
      }
    },
    {
      "src": "^/style/about$",
      "status": 308,
      "headers": {
        "Location": "/style/about/"
      }
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/style/$",
      "dest": "/style/index.html"
    },
    {
      "src": "^/style/goggles-sunglasses/$",
      "dest": "/style/goggles-sunglasses/index.html"
    },
    {
      "src": "^/style/baggy-lowers/$",
      "dest": "/style/baggy-lowers/index.html"
    },
    {
      "src": "^/style/looks/$",
      "dest": "/style/looks/index.html"
    },
    {
      "src": "^/style/about/$",
      "dest": "/style/about/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
