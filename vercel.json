{
  "buildCommand": "cd frontend && yarn build",
  "outputDirectory": "frontend/build",
  "installCommand": "cd frontend && yarn install",
  "framework": null,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/.*$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://open.spotify.com; worker-src 'self' blob:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/style/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/"
      }
    },
    {
      "src": "^/style/goggles-sunglasses/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/goggles-sunglasses/"
      }
    },
    {
      "src": "^/style/baggy-lowers/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/baggy-lowers/"
      }
    },
    {
      "src": "^/style/looks/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/looks/"
      }
    },
    {
      "src": "^/style/about/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/about/"
      }
    },
    {
      "src": "^/style$",
      "status": 308,
      "headers": {
        "Location": "/style/"
      }
    },
    {
      "src": "^/style/goggles-sunglasses$",
      "status": 308,
      "headers": {
        "Location": "/style/goggles-sunglasses/"
      }
    },
    {
      "src": "^/style/baggy-lowers$",
      "status": 308,
      "headers": {
        "Location": "/style/baggy-lowers/"
      }
    },
    {
      "src": "^/style/looks$",
      "status": 308,
      "headers": {
        "Location": "/style/looks/"
      }
    },
    {
      "src": "^/style/about$",
      "status": 308,
      "headers": {
        "Location": "/style/about/"
      }
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/style/$",
      "dest": "/style/index.html"
    },
    {
      "src": "^/style/goggles-sunglasses/$",
      "dest": "/style/goggles-sunglasses/index.html"
    },
    {
      "src": "^/style/baggy-lowers/$",
      "dest": "/style/baggy-lowers/index.html"
    },
    {
      "src": "^/style/looks/$",
      "dest": "/style/looks/index.html"
    },
    {
      "src": "^/style/about/$",
      "dest": "/style/about/index.html"
    },
    {
      "src": "^/style/hoodies-brand/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/hoodies-brand/"
      }
    },
    {
      "src": "^/style/hoodies-brand$",
      "status": 308,
      "headers": {
        "Location": "/style/hoodies-brand/"
      }
    },
    {
      "src": "^/style/hoodies-brand/$",
      "dest": "/style/hoodies-brand/index.html"
    },
    {
      "src": "^/bigg-boss-20/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/bigg-boss-20/"
      }
    },
    {
      "src": "^/bigg-boss-20$",
      "status": 308,
      "headers": {
        "Location": "/bigg-boss-20/"
      }
    },
    {
      "src": "^/bigg-boss-20/$",
      "dest": "/bigg-boss-20/index.html"
    },
    {
      "src": "^/slang-guide/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/slang-guide/"
      }
    },
    {
      "src": "^/slang-guide$",
      "status": 308,
      "headers": {
        "Location": "/slang-guide/"
      }
    },
    {
      "src": "^/slang-guide/$",
      "dest": "/slang-guide/index.html"
    },
    {
      "src": "^/wallpapers/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/wallpapers/"
      }
    },
    {
      "src": "^/wallpapers$",
      "status": 308,
      "headers": {
        "Location": "/wallpapers/"
      }
    },
    {
      "src": "^/wallpapers/$",
      "dest": "/wallpapers/index.html"
    },
    {
      "src": "^/style/fit-check/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/style/fit-check/"
      }
    },
    {
      "src": "^/style/fit-check$",
      "status": 308,
      "headers": {
        "Location": "/style/fit-check/"
      }
    },
    {
      "src": "^/style/fit-check/$",
      "dest": "/style/fit-check/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "crons": [
    {
      "path": "/api/receipt_retention",
      "schedule": "25 2 * * *"
    }
  ]
}
